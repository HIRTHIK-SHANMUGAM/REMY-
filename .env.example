# ── REMY configuration ──────────────────────────────────────────────
# Server identity
SERVER_NAME=REMY
DEBUG=false

# The user REMY serves
REMY_USER_NAME=Hirthik

# Bind address for the MCP server + web API. Local-only by default.
# Do NOT change to 0.0.0.0 unless you explicitly want LAN exposure.
REMY_BIND_HOST=127.0.0.1
REMY_MCP_PORT=8000
REMY_API_PORT=8377

# Heartbeat interval in minutes (autonomy loop). 0 disables it.
REMY_HEARTBEAT_MINUTES=20

# Directories REMY is allowed to touch (colon-separated on mac/Linux,
# semicolon-separated on Windows). Defaults to ~/RemyWorkspace.
REMY_ALLOWED_DIRS=

# ── Reasoning engines ───────────────────────────────────────────────
# Claude powers the Orchestrator/Reviewer (heaviest reasoning).
ANTHROPIC_API_KEY=
REMY_ORCHESTRATOR_MODEL=claude-fable-5
REMY_EXECUTOR_MODEL=claude-sonnet-5
REMY_REVIEWER_MODEL=claude-sonnet-5
# Watcher runs every heartbeat — keep it cheap. Set to "ollama:<model>"
# (e.g. ollama:llama3.2) to use a local model, or a Claude model id.
REMY_WATCHER_MODEL=claude-haiku-4-5-20251001
OLLAMA_URL=http://127.0.0.1:11434

# ── Voice pipeline (optional — LiveKit) ─────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
