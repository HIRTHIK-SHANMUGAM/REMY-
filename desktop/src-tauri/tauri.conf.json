{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REMY",
  "version": "1.0.1",
  "identifier": "app.remy.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "beforeBuildCommand": "npm --prefix ../../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "REMY",
        "width": 1200,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#0b0f14"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "REMY — autonomous agent"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
