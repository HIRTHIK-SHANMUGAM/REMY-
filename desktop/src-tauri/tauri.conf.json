{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REMY",
  "version": "0.1.0",
  "identifier": "app.remy.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "REMY",
        "url": "http://127.0.0.1:8377/",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#040a0d"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "REMY — autonomous agent"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": ["icons/icon.png"]
  }
}
